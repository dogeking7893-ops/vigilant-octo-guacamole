function UpdateInventory()

    ClearInventoryRows()

    local Character = Player.Character
    local Backpack = Player:FindFirstChildOfClass("Backpack")

    local Items = {}

    if Backpack then

        for _, Item in ipairs(Backpack:GetChildren()) do

            if Item:IsA("Tool") then

                table.insert(Items, {
                    Tool = Item,
                    Equipped = false
                })

            end

        end

    end

    if Character then

        for _, Item in ipairs(Character:GetChildren()) do

            if Item:IsA("Tool") then

                table.insert(Items, {
                    Tool = Item,
                    Equipped = true
                })

            end

        end

    end

    InventoryCount.Text =
        tostring(#Items) .. " ITEMS"

    local Query =
        string.lower(InventorySearch.Text)

    for _, Info in ipairs(Items) do

        if Query == ""
        or string.find(
            string.lower(Info.Tool.Name),
            Query,
            1,
            true
        ) then

            AddInventoryItem(
                Info.Tool,
                Info.Equipped
            )

        end

    end

end

