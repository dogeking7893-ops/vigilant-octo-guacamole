    }, SpeedBadge)

    --========================================================
    -- SLIDER TRACK
    --========================================================

    local Track = Create("Frame", {
        Size = UDim2.new(1, -24, 0, 10),
        Position = UDim2.new(0, 12, 0, 52),
        BackgroundColor3 = C.Background,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0
    }, SpeedCard)

    Round(Track, 5)
    Outline(Track, C.Cyan, 1, 0.55)

    -- Filled portion (progress)
    local Fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = C.Cyan,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0
    }, Track)
    Round(Fill, 5)

    MakeGradient(Fill, C.Cyan, C.Violet, 0)

    --========================================================
    -- KNOB (REDESIGNED - SMALLER + GLOWING)
    --========================================================

    -- Glow aura behind knob
    local KnobGlow = Create("Frame", {
        Size = UDim2.fromOffset(26, 26),
        Position = UDim2.new(0, -13, 0.5, -13),
        BackgroundColor3 = C.Cyan,
        BackgroundTransparency = 0.75,
        BorderSizePixel = 0,
        ZIndex = 4
    }, Track)
    Round(KnobGlow, 13)

    -- Knob body
    local Knob = Create("Frame", {
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.new(0, -9, 0.5, -9),
        BackgroundColor3 = C.Blue,
        BorderSizePixel = 0,
