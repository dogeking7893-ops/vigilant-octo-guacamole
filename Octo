--========================================================
-- AIMBOT BACKEND RENDER LOOP (INSTANT SNAP LOCK)
--========================================================

RunService = game:GetService("RunService")

RunService.RenderStepped:Connect(function(dt)
    if not AimbotActive then
        AimUIStatus.Text = "● AIMBOT OFF"
        AimUIStatus.TextColor3 = C.Gray
        return
    end

    if not SelectedTargetPlayer or not SelectedTargetPlayer.Character then
        AimUIStatus.Text = "● NO VALID PLAYER SELECTED"
        AimUIStatus.TextColor3 = C.Red
        return
    end

    local char = SelectedTargetPlayer.Character
    local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if targetPart and humanoid and humanoid.Health > 0 then
        AimUIStatus.Text = "● INSTANT LOCKED: " .. SelectedTargetPlayer.Name
        AimUIStatus.TextColor3 = C.Green

        local currentCFrame = Camera.CFrame
        local targetCFrame = CFrame.new(currentCFrame.Position, targetPart.Position)
        Camera.CFrame = currentCFrame:Lerp(targetCFrame, 1.0)
    else
        AimUIStatus.Text = "● TARGET IS DEAD OR MISSING"
        AimUIStatus.TextColor3 = C.Red
    end
end)

