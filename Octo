--==================================================
-- MAIN WINDOW DRAGGING
--==================================================

Dragging = false
DragStart = nil
StartPosition = nil

Header.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = Input.Position
        StartPosition = Main.Position
    end
end)

UIS.InputChanged:Connect(function(Input)

    if Dragging and (
        Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch
    ) then

        local Delta = Input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        Dragging = false
    end
end)

--==================================================
-- OPEN / CLOSE WINDOW
--==================================================

WindowOpen = false

NormalPosition = Main.Position
NormalSize = Main.Size

Main.Visible = false

function OpenWindow()

    if WindowOpen then
        return
    end

    WindowOpen = true
    Main.Visible = true

    Main.Position = UDim2.new(
        NormalPosition.X.Scale,
        NormalPosition.X.Offset,
        NormalPosition.Y.Scale,
        NormalPosition.Y.Offset + 15
    )

    Main.BackgroundTransparency = 0.25

    Animate(Main, {
        Position = NormalPosition,
        BackgroundTransparency = 0.04
    }, 0.22)
end

function CloseWindow()

    if not WindowOpen then
        return
    end

    WindowOpen = false

    Animate(Main, {
        BackgroundTransparency = 1,
        Position = UDim2.new(
            Main.Position.X.Scale,
            Main.Position.X.Offset,
            Main.Position.Y.Scale,
            Main.Position.Y.Offset + 15
        )
    }, 0.18)

    task.delay(0.2, function()

        if not WindowOpen then
            Main.Visible = false
        end
    end)
end

--==================================================
-- MAXIMIZE / RESTORE
--==================================================

Maximized = false

function ToggleMaximize()

    if not Maximized then

        NormalPosition = Main.Position
        NormalSize = Main.Size

        Maximized = true

        local Viewport = Camera.ViewportSize

        Animate(Main, {
            Position = UDim2.new(0, 8, 0, 8),
            Size = UDim2.new(
                0,
                math.max(250, Viewport.X - 16),
                0,
                math.max(200, Viewport.Y - 16)
            )
        }, 0.2)

    else

        Maximized = false

        Animate(Main, {
            Position = NormalPosition,
            Size = NormalSize
        }, 0.2)
    end
end

