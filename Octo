    local KnobCore = Create("Frame", {
        Size = UDim2.fromOffset(4, 4),
        Position = UDim2.new(0.5, -2, 0.5, -2),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0,
        ZIndex = 6
    }, Knob)
    Round(KnobCore, 2)

    --========================================================
    -- SLIDER LOGIC
    --========================================================

    local MIN_VALUE = 1
    local MAX_VALUE = 1000
    local CurrentValue = 16

    local function updateSpeed(value)
        CurrentValue = value
        SpeedValueLabel.Text = tostring(value)

        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = value
        end
    end

    local function setFromPosition(xPosition)
        local trackWidth = Track.AbsoluteSize.X
        if trackWidth <= 0 then return end

        local relative = xPosition / trackWidth
        relative = math.clamp(relative, 0, 1)

        local value = MIN_VALUE + (MAX_VALUE - MIN_VALUE) * relative
        value = math.floor(value + 0.5)

        updateSpeed(value)

        local knobPos = relative * trackWidth
        Knob.Position = UDim2.new(0, knobPos - 9, 0.5, -9)
        KnobGlow.Position = UDim2.new(0, knobPos - 13, 0.5, -13)
        Fill.Size = UDim2.new(relative, 0, 1, 0)
    end

    --========================================================
    -- DRAG INPUT
    --========================================================

    local dragging = false

    local function getRelativeX(input)
        local trackPos = Track.AbsolutePosition.X
        return input.Position.X - trackPos
    end

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromPosition(getRelativeX(input))
            Animate(KnobGlow, { BackgroundTransparency = 0.6 }, 0.15)
        end
    end)

    Knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Animate(KnobGlow, { BackgroundTransparency = 0.6 }, 0.15)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            setFromPosition(getRelativeX(input))
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            Animate(KnobGlow, { BackgroundTransparency = 0.75 }, 0.2)
        end
    end)

    --========================================================
    -- AUTO-REAPPLY ON RESPAWN
    --========================================================

    Player.CharacterAdded:Connect(function(char)
        task.wait(1)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = CurrentValue
        end
    end)

    --========================================================
    -- INITIALIZE
    --========================================================

    task.defer(function()
        task.wait(0.2)
        local trackWidth = Track.AbsoluteSize.X
        if trackWidth > 0 then
            local relative = (16 - MIN_VALUE) / (MAX_VALUE - MIN_VALUE)
            local knobPos = relative * trackWidth
            Knob.Position = UDim2.new(0, knobPos - 9, 0.5, -9)
            KnobGlow.Position = UDim2.new(0, knobPos - 13, 0.5, -13)
            Fill.Size = UDim2.new(relative, 0, 1, 0)
        end
        updateSpeed(16)
    end)

    print("SPEED SLIDER DONE")

end)

if not ok then
    warn("SPEED SLIDER ERROR: " .. tostring(err))
end
