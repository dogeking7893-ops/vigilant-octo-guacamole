function AddGraphPoint(Graph, Points, Value, Maximum)

    local Point = Create("Frame", {
        Size = UDim2.fromOffset(4, 4),

        BackgroundColor3 = C.Cyan,

        BorderSizePixel = 0,

        Parent = Graph
    })

    Round(Point, 4)

    local Alpha =
        math.clamp(Value / Maximum, 0, 1)

    Point.Position =
        UDim2.new(
            1,
            0,
            1 - Alpha,
            -2
        )

    table.insert(Points, Point)

    if #Points > 28 then

        local Old = table.remove(Points, 1)

        if Old then
            Old:Destroy()
        end

    end

    local Width = Graph.AbsoluteSize.X

    if Width > 0 then

        for Index, Existing in ipairs(Points) do

            local X =
                ((Index - 1) / 27) * Width

            Existing.Position =
                UDim2.new(
                    0,
                    X,
                    Existing.Position.Y.Scale,
                    Existing.Position.Y.Offset
                )

        end

    end

end

